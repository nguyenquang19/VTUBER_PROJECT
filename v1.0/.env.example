# Mai - AI VTuber env template
# Copy sang .env và điền giá trị thật. KHÔNG commit .env.

# llama-server (main instance)
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7860

# VTube Studio (Phase 6)
VTS_HOST=127.0.0.1
VTS_PORT=8001
VTS_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Data
DATA_DIR=data
BACKUP_DIR=backups
